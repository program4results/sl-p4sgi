+"""Pull GAM CSV runs from GCS when GAM_GCS_BUCKET is set (cloud path).
+
+On gbu, gam-sync.sh uploads docker-data/.../gam-out/runs/* to
+  gs://$BUCKET/$COUNTRY/gam-out/runs/
+This module mirrors that prefix into local DATA_DIR/gam-out/runs so the
+existing file-based GAM report endpoints keep working without host `gam`.
+"""
+from __future__ import annotations
+
+import logging
+import os
+from pathlib import Path
+
+log = logging.getLogger("p4sgi.gcs_gam")
+
+
+def sync_gam_csvs_from_gcs(dest_runs_dir: Path) -> int:
+    """Download objects under the country prefix into dest_runs_dir.
+
+    Returns number of objects fetched. No-op if GAM_GCS_BUCKET unset.
+    Requires google-cloud-storage on the image (add to requirements.txt).
+    """
+    bucket_name = os.getenv("GAM_GCS_BUCKET", "").strip()
+    if not bucket_name:
+        return 0
+    country = os.getenv("COUNTRY", "sl").strip() or "sl"
+    prefix = f"{country}/gam-out/runs/"
+    dest_runs_dir.mkdir(parents=True, exist_ok=True)
+
+    try:
+        from google.cloud import storage  # type: ignore
+    except ImportError as exc:  # pragma: no cover
+        log.warning("google-cloud-storage not installed; skip GCS sync: %s", exc)
+        return 0
+
+    client = storage.Client()
+    bucket = client.bucket(bucket_name)
+    n = 0
+    for blob in client.list_blobs(bucket_name, prefix=prefix):
+        name = blob.name[len(prefix) :]
+        if not name or name.endswith("/"):
+            continue
+        target = dest_runs_dir / name
+        if target.is_file() and target.stat().st_size == blob.size:
+            continue
+        target.parent.mkdir(parents=True, exist_ok=True)
+        blob.download_to_filename(str(target))
+        n += 1
+    log.info("GCS GAM sync: fetched %s object(s) from gs://%s/%s", n, bucket_name, prefix)
+    return n
