# SL-P4SGI Admin Dashboard — example env (copy to .env; never commit real secrets)

# Postgres
POSTGRES_DB=slp4sgi
POSTGRES_USER=slp4sgi
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_HOST=db
POSTGRES_PORT=5432

# App
APP_ENV=development
APP_PORT=8088
DATA_DIR=/data

# Host paths (compose mounts; relative to this stack by default)
# Absolute alternative: /home/george/drive_14tb/docker-data/sl.p4sgi
DATA_HOST_DIR=../../docker-data/sl.p4sgi

# Phase 3 — optional publish-audit webhook secret.
# If set, POST /api/v1/publish-events requires header:
#   X-Publish-Audit-Token: <same value>
#   or Authorization: Bearer <same value>
# Leave blank to allow unauthenticated ingest (dev / pilot).
PUBLISH_AUDIT_TOKEN=

# Future — Phase 4; leave blank
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GAM_SERVICE_ACCOUNT_JSON=
# REDIS_URL=

# Phase 3.1 — host GAM (compose mounts binary + ~/.gam; usually leave defaults)
# GAM_BIN=/home/george/bin/gam7/gam
# GAM_RUNNER=/app/scripts/run_gam_report.sh
# GAM_TIMEOUT_SEC=600

# PUBLIC_BASE_URL: local dash only (HQ preview). Parent Site charts use Google Apps Script
# HtmlService (googleRadarExecUrl) — see docs/SITE_ATTENDANCE_EMBED.md.
# Cloudflare / public HTTPS for :8088 is optional and deferred for this pilot.
PUBLIC_BASE_URL=http://127.0.0.1:8088

# Super-admin login emails (comma-separated). Full RBAC scoping comes later;
# helper is_superadmin() uses this list. Default: geb@p4sgi.com only.
SUPERADMIN_EMAILS=geb@p4sgi.com

# Optional dedicated GAM config dir (compose mount). Leave unset to use ~/.gam
# (already authenticated as geb@p4sgi.com on this host).
# GAMCFGDIR=/mnt/drive_14tb/stacks/sl.p4sgi/gam-geb
# GAM_HOST_CFGDIR=./gam-geb


# 0.4.18 — Drive Doc/Sheet exports (GAM user geb@p4sgi.com)
DRIVE_EXPORT_FOLDER_ID=1r2lyU95j4BpdaLxLL-ayhl2Vsz7LnTYZ
GAM_EXPORT_USER=geb@p4sgi.com
# GAM_UPLOAD_TIMEOUT_SEC=180

# 0.4.22 Admin assist. Default: local Ollama only. To use Gemini (anonymised facts only) use a PAID / Vertex-grade key, not a free key:
# CHAT_CLOUD_ENABLED=1
# GEMINI_API_KEY=
# GEMINI_MODEL=
# ASSIST_ENGINE=local     # force local even if Gemini is configured
# ASSIST_ENABLED=0        # kill switch
# SEC_APPROVAL_DAYS=180

# 0.4.23 Faster Admin assist: a smaller local model for assist/help answers (leave empty to use CHAT_MODEL)
# ASSIST_MODEL=qwen2.5:7b
# Optional SMTP so a super-admin can SEND the drafted emails (only to the people on the selected rows, max 30/hour, logged).
# Without it the dashboard only opens the draft in your mail program.
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=it@yourdomain
# SMTP_SECURITY=starttls   # starttls | ssl | none

# ---- 0.4.26 RUSTAiDMIN (all optional) ----
# RUSTADMIN_ENABLED=0           # kill switch for the dashboard section
# RUSTDESK_HOST=rd.example.org  # public name/IP of the RustDesk ID server (tablets must reach it)
# RUSTDESK_RELAY=               # blank = same as host
# RUSTDESK_CONSOLE_URL=http://rd.example.org:21114/_admin/
# RUSTDESK_SERVER_TAG=latest    # or pin, e.g. a version tag
# INSTALL_ADB=1                 # build the web image with the adb client
# RUSTADMIN_ADB_ENABLED=1       # allow read-only ADB diagnostics (super-admin only)
# RUSTADMIN_ADB_ALLOW_CHANGES=0 # 1 = allow commands that change a tablet (typed confirmation + audit)
# RUSTADMIN_ADB_NETS=100.64.0.0/10,192.168.0.0/16   # networks adb may talk to

