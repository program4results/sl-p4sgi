# Copy to env.sh and fill in. Source before deploy:  set -a; source ./env.sh; set +a
# Do NOT commit real secrets. Fill PROJECT_ID after: gcloud auth login geb@p4sgi.com

# --- Required ---
# Google Cloud project ID (from console or: gcloud projects list --account=geb@p4sgi.com after login)
PROJECT_ID=YOUR_GCP_PROJECT_ID

# Region: africa-south1 (Johannesburg) has both Cloud Run and Cloud SQL for PostgreSQL.
# europe-west1 (Belgium) is a solid alternative (Tier-1 Cloud Run pricing, Low CO2).
REGION=africa-south1

# Country / Workspace parameterisation (re-run this package per country)
COUNTRY=sl
DOMAIN=sl.p4sgi.com
HOSTNAME=dash.sl.p4sgi.com

# IAP principals: prefer a Google Group of admins, else the whole Workspace domain.
# Examples:
#   ADMIN_GROUP=group:dash-admins@sl.p4sgi.com
#   ADMIN_GROUP=domain:sl.p4sgi.com
ADMIN_GROUP=domain:sl.p4sgi.com

# --- Derived names (override if you like) ---
SERVICE_NAME=${COUNTRY}-p4sgi-web
SQL_INSTANCE=${COUNTRY}-p4sgi-pg
SQL_DB_NAME=slp4sgi
SQL_USER=slp4sgi
AR_REPO=${COUNTRY}-p4sgi
BUCKET_NAME=${PROJECT_ID}-${COUNTRY}-p4sgi-gam
SA_RUNTIME=${COUNTRY}-p4sgi-run
SECRET_DB_PASSWORD=${COUNTRY}-p4sgi-db-password

# Cloud SQL tier (smallest shared-core; not SLA-covered — fine for pilot)
SQL_TIER=db-f1-micro
SQL_STORAGE_GB=10
SQL_VERSION=POSTGRES_16

# Cloud Run
CLOUD_RUN_CPU=1
CLOUD_RUN_MEMORY=512Mi
CLOUD_RUN_MIN_INSTANCES=0
CLOUD_RUN_MAX_INSTANCES=3
CLOUD_RUN_PORT=8000
CLOUD_RUN_TIMEOUT=300

# Custom domain via HTTPS LB + serverless NEG + Google-managed cert.
# IAP is enabled DIRECTLY on Cloud Run (GA); do not also enable IAP on the LB.
ENABLE_LB=true
LB_NAME=${COUNTRY}-p4sgi-lb
NEG_NAME=${COUNTRY}-p4sgi-neg
BACKEND_NAME=${COUNTRY}-p4sgi-backend
URLMAP_NAME=${COUNTRY}-p4sgi-urlmap
CERT_NAME=${COUNTRY}-p4sgi-cert
HTTPS_PROXY_NAME=${COUNTRY}-p4sgi-https-proxy
FWD_RULE_NAME=${COUNTRY}-p4sgi-https
IP_NAME=${COUNTRY}-p4sgi-ip

# Local paths (gbu host)
STACK_DIR=/mnt/drive_14tb/stacks/sl.p4sgi
GAM_OUT_HOST=/mnt/drive_14tb/docker-data/sl.p4sgi/gam-out
COMPOSE_DB_CONTAINER=sl-p4sgi-db
LOCAL_PG_PORT=5439

# IAP JWT audience (filled after deploy; used by app patch)
# Format for Cloud Run: /projects/PROJECT_NUMBER/locations/REGION/services/SERVICE_NAME
IAP_AUDIENCE=
IAP_ALLOWED_EMAIL_SUFFIX=@${DOMAIN}

# gcloud identity for deploy (EVERYTHING for sl.p4sgi → geb@p4sgi.com).
# George must run interactively:  gcloud auth login geb@p4sgi.com
ACCOUNT=geb@p4sgi.com

# Optional: create the project under the p4sgi.com organisation when --apply
# and PROJECT_ID does not exist yet. Leave empty to skip org-scoped create.
# Discover with: gcloud organizations list --account=geb@p4sgi.com
# ORG_ID=
# CREATE_PROJECT_IF_MISSING=false
# PROJECT_NAME=SL P4SGI Dashboard

# IAP: keep domain:sl.p4sgi.com for school admins, plus geb as super-admin.
# ADMIN_GROUP above remains domain:sl.p4sgi.com; deploy.sh also binds SUPERADMIN_IAP.
SUPERADMIN_IAP=user:geb@p4sgi.com

# App env passed to Cloud Run (super-admin helper; full RBAC later)
SUPERADMIN_EMAILS=geb@p4sgi.com
